{
  "manifest_version": 2,
  "name": "Claude Folders",
  "version": "0.1.0",
  "description": "Folders, pins and a home screen merged into the claude.ai sidebar, with a one-click Classic switch.",
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": { "id": "claude-folders@risen372", "strict_min_version": "113.0", "data_collection_permissions": { "required": ["none"] } }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
